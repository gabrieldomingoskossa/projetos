<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JG STORE - Sistema Completo</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Inter', sans-serif; background: #020617; color: #e2e8f0; line-height: 1.5; }
        .login-container { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: #020617; display: flex; align-items: center; justify-content: center; z-index: 1000; }
        .login-card { background: #0f172a; padding: 40px; border-radius: 24px; width: 100%; max-width: 400px; border: 1px solid #1e293b; box-shadow: 0 20px 35px rgba(0,0,0,0.5); }
        .login-card h2 { text-align: center; margin-bottom: 30px; color: #3b82f6; font-size: 24px; }
        .login-card input { width: 100%; padding: 14px; margin-bottom: 20px; border-radius: 12px; border: 1px solid #1e293b; background: #020617; color: #fff; font-size: 16px; }
        .login-card input:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
        .login-card button { width: 100%; padding: 14px; background: #3b82f6; border: none; border-radius: 12px; color: white; font-weight: bold; font-size: 16px; cursor: pointer; transition: 0.3s; }
        .login-card button:hover { background: #2563eb; transform: translateY(-2px); }
        .error-msg { color: #ef4444; text-align: center; margin-top: 15px; font-size: 14px; }
        .main-system { display: none; }
        .top-bar { position: fixed; top: 0; left: 0; right: 0; height: 60px; background: #0f172a; border-bottom: 1px solid #1e293b; display: flex; align-items: center; justify-content: space-between; padding: 0 30px; z-index: 999; }
        .top-bar-title { font-size: 20px; font-weight: 600; color: #3b82f6; }
        .logout-btn { background: #ef4444; color: white; border: none; padding: 8px 16px; border-radius: 8px; cursor: pointer; font-size: 14px; }
        .logout-btn:hover { background: #dc2626; }
        .sidebar { width: 260px; height: 100vh; position: fixed; background: #020617; border-right: 1px solid rgba(255,255,255,0.08); padding: 80px 25px 25px; overflow-y: auto; top: 0; }
        .menu button { width: 100%; display: flex; align-items: center; gap: 12px; padding: 12px 16px; margin-bottom: 8px; border: none; background: transparent; color: #94a3b8; border-radius: 12px; cursor: pointer; font-size: 15px; text-align: left; transition: 0.2s; }
        .menu button:hover { background: #0f172a; color: #3b82f6; }
        .menu button.active { background: #0f172a; color: #3b82f6; font-weight: 600; }
        .main { margin-left: 280px; padding: 90px 30px 30px; margin-top: 0; }
        .box { display: none; background: #0a1120; padding: 25px; border-radius: 20px; animation: slideIn 0.3s ease-out; }
        @keyframes slideIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .box.active { display: block; }
        h2 { margin-bottom: 20px; font-size: 26px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 15px; }
        h3 { margin: 25px 0 15px; font-size: 20px; color: #e2e8f0; }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 18px; margin-bottom: 20px; }
        .form-group { display: flex; flex-direction: column; }
        .form-group label { font-size: 13px; color: #94a3b8; margin-bottom: 6px; font-weight: 500; }
        .required { color: #ef4444; margin-left: 4px; }
        input, select, textarea { width: 100%; padding: 12px; border-radius: 10px; border: 1px solid #1e293b; background: #020617; color: #fff; font-size: 14px; font-family: 'Inter', sans-serif; }
        input:focus, select:focus, textarea:focus { outline: none; border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.1); }
        .btn { padding: 10px 20px; border: none; border-radius: 10px; background: #3b82f6; color: white; cursor: pointer; font-weight: 500; transition: 0.2s; display: inline-block; margin-right: 8px; margin-bottom: 8px; font-size: 14px; }
        .btn:hover { background: #2563eb; transform: translateY(-2px); }
        .btn-danger { background: #ef4444; }
        .btn-danger:hover { background: #dc2626; }
        .btn-success { background: #22c55e; }
        .btn-warning { background: #f59e0b; color: #000; }
        .btn-sm { padding: 6px 12px; font-size: 12px; }
        .refresh-btn { background: #1e293b; color: #3b82f6; }
        .table-responsive { overflow-x: auto; width: 100%; margin-top: 20px; border-radius: 10px; border: 1px solid #1e293b; }
        table { width: 100%; border-collapse: collapse; min-width: 600px; }
        th { text-align: left; padding: 14px; background: #1e293b; color: #64748b; font-weight: 600; border-bottom: 2px solid #0f172a; }
        td { padding: 14px; border-bottom: 1px solid #1e293b; }
        tr:hover { background: #0f172a; }
        .status { padding: 6px 12px; border-radius: 20px; font-size: 12px; font-weight: 600; display: inline-block; }
        .pago { background: #22c55e; color: #000; }
        .pendente { background: #f59e0b; color: #000; }
        .search-input { width: 100%; padding: 12px; margin-bottom: 20px; border-radius: 10px; background: #020617; border: 1px solid #1e293b; color: #fff; }
        .alert-card { background: #1e293b; border-left: 4px solid #f59e0b; padding: 15px; margin-bottom: 20px; border-radius: 8px; }
        .alert-item { padding: 8px 0; border-bottom: 1px solid #0f172a; font-size: 14px; }
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 2000; justify-content: center; align-items: center; padding: 20px; }
        .modal.active { display: flex; }
        .modal-content { background: #0f172a; padding: 25px; border-radius: 16px; max-width: 600px; width: 100%; max-height: 80vh; overflow-y: auto; position: relative; }
        .close-modal { position: absolute; top: 15px; right: 15px; cursor: pointer; font-size: 24px; color: #94a3b8; background: none; border: none; }
        .close-modal:hover { color: #ef4444; }
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; margin-bottom: 30px; }
        .stat-card { background: #1e293b; padding: 20px; border-radius: 12px; border-left: 4px solid #3b82f6; cursor: pointer; transition: 0.2s; }
        .stat-card:hover { background: #334155; transform: translateY(-2px); }
        .stat-label { color: #94a3b8; font-size: 13px; margin-bottom: 8px; }
        .stat-value { color: #3b82f6; font-size: 28px; font-weight: 700; }
        .toast { position: fixed; bottom: 20px; right: 20px; background: #0f172a; border-left: 4px solid #3b82f6; color: #e2e8f0; padding: 16px; border-radius: 10px; z-index: 3000; max-width: 300px; animation: slideInRight 0.3s ease-out; }
        .toast.success { border-left-color: #22c55e; }
        .toast.error { border-left-color: #ef4444; }
        @keyframes slideInRight { from { transform: translateX(400px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
        .section-separator { border-top: 2px solid #1e293b; margin: 40px 0; padding-top: 30px; }
        @media (max-width: 768px) {
            .sidebar { width: 100%; height: auto; position: fixed; padding: 80px 15px 15px; }
            .main { margin-left: 0; padding: 140px 15px 30px; }
            .menu { display: flex; flex-wrap: wrap; gap: 8px; }
            .menu button { width: auto; flex: 1; min-width: 120px; }
        }
    </style>
</head>
<body>

<div id="loginContainer" class="login-container">
    <div class="login-card">
        <h2>🔐 Acesso JG STORE</h2>
        <input type="text" id="loginUser" placeholder="Usuário" autocomplete="off">
        <input type="password" id="loginPass" placeholder="Senha">
        <button onclick="fazerLogin()">Entrar</button>
        <div id="loginError" class="error-msg"></div>
    </div>
</div>

<div class="main-system" id="mainSystem">
    <div class="top-bar">
        <div class="top-bar-title">📊 JG STORE - Sistema de Gestão</div>
        <button class="logout-btn" onclick="fazerLogout()">Sair</button>
    </div>

    <div class="sidebar">
        <div class="menu">
            <button onclick="irPara(this,'dashboard')" class="active">📊 Dashboard</button>
            <button onclick="irPara(this,'cadastroClientes')">➕ Cadastrar Clientes</button>
            <button onclick="irPara(this,'listaClientes')">👥 Meus Clientes</button>
            <button onclick="irPara(this,'vendasAvista')">💰 Vendas à Vista</button>
            <button onclick="irPara(this,'clientesFinanceiros')">📆 Vendas Parceladas</button>
            <button onclick="irPara(this,'pagamentos')">💵 Pagamentos</button>
            <button onclick="irPara(this,'estoque')">📦 Estoque</button>
            <button onclick="irPara(this,'fornecedores')">🚚 Fornecedores</button>
            <button onclick="irPara(this,'relatorios')">📈 Relatórios</button>
        </div>
    </div>

    <div class="main">
        <!-- DASHBOARD -->
        <div id="dashboard" class="box active">
            <h2>📊 Dashboard <button class="btn refresh-btn" onclick="carregarDashboard()">🔄</button></h2>
            <div class="stats-grid">
                <div class="stat-card" onclick="navegarPara('listaClientes')"><div class="stat-label">👥 Clientes</div><div class="stat-value" id="statClientes">0</div></div>
                <div class="stat-card" onclick="navegarPara('vendasAvista')"><div class="stat-label">💰 Vendas à Vista</div><div class="stat-value" id="statVendasAvista">0</div></div>
                <div class="stat-card" onclick="navegarPara('clientesFinanceiros')"><div class="stat-label">📆 Vendas Parceladas</div><div class="stat-value" id="statVendasParceladas">0</div></div>
                <div class="stat-card" style="border-left-color:#22c55e;" onclick="navegarPara('relatorios')"><div class="stat-label">💵 Receita Total</div><div class="stat-value">R$ <span id="statReceita">0</span></div></div>
            </div>
            <div class="stats-grid">
                <div class="stat-card" style="border-left-color:#f59e0b;" onclick="navegarPara('fornecedores')"><div class="stat-label">📦 Gasto Fornecedores</div><div class="stat-value">R$ <span id="statGastoFornecedores">0</span></div></div>
                <div class="stat-card" style="border-left-color:#10b981;" onclick="navegarPara('relatorios')"><div class="stat-label">📈 Lucro Total</div><div class="stat-value">R$ <span id="statLucroTotal">0</span></div></div>
                <div class="stat-card" style="border-left-color:#ef4444;" onclick="navegarPara('clientesFinanceiros')"><div class="stat-label">⚠️ Inadimplentes</div><div class="stat-value" id="statInadimplentes">0</div></div>
                <div class="stat-card" style="border-left-color:#8b5cf6;" onclick="navegarPara('clientesFinanceiros')"><div class="stat-label">💳 A Receber</div><div class="stat-value">R$ <span id="statAReceber">0</span></div></div>
            </div>
            <h3>📈 Vendas por Mês (à vista + parceladas)</h3>
            <div class="table-responsive"><canvas id="graficoVendas" style="max-height:300px;"></canvas></div>
            <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(400px,1fr)); gap:30px; margin-top:40px;">
                <div><h3>🏆 Top 5 Produtos Vendidos</h3><div class="table-responsive"><table id="tabTopProdutos"><thead><tr><th>Produto</th><th>Qtd</th><th>Faturamento</th></tr></thead><tbody></tbody></table></div></div>
                <div><h3>🚚 Top 5 Fornecedores</h3><div class="table-responsive"><table id="tabTopFornecedores"><thead><tr><th>Fornecedor</th><th>Produtos</th><th>Gasto</th></tr></thead><tbody></tbody></table></div></div>
            </div>
            <div class="section-separator"><h3>⚠️ Clientes Inadimplentes (Com Débito)</h3><div class="table-responsive"><table id="tabInadimplentes"><thead><tr><th>Cliente</th><th>Débito</th><th>% Pago</th><th>Próximo Venc.</th><th>Ação</th></tr></thead><tbody></tbody></table></div></div>
            <div class="section-separator"><h3>💼 Resumo Financeiro</h3><div class="table-responsive"><table><thead><tr><th>Descrição</th><th>Valor</th><th>%</th></tr></thead><tbody><tr style="background:#1e293b;"><td><strong>💵 Receita Total</strong></td><td><strong>R$ <span id="resReceita">0</span></strong></td><td><strong>100%</strong></td></tr><tr><td>📦 Custo Fornecedores</td><td>R$ <span id="resCusto">0</span></td><td><span id="resPercentualCusto">0</span>%</td></tr>
                <tr style="background:#1e293b;"><td><strong style="color:#10b981;">📈 Lucro Bruto</strong></td><td><strong style="color:#10b981;">R$ <span id="resLucro">0</span></strong></td><td><strong style="color:#10b981;"><span id="resPercentualLucro">0</span>%</strong></td></tr>
            </tbody></table></div></div>
        </div>

        <!-- CADASTRO CLIENTES -->
        <div id="cadastroClientes" class="box">
            <h2>➕ Cadastrar Novo Cliente</h2>
            <div class="form-grid">
                <div class="form-group"><label>Nome *</label><input type="text" id="nomeClienteCadastro"></div>
                <div class="form-group"><label>Telefone</label><input type="text" id="telefoneClienteCadastro"></div>
                <div class="form-group"><label>Email</label><input type="text" id="emailClienteCadastro"></div>
                <div class="form-group"><label>CPF/CNPJ</label><input type="text" id="cpfClienteCadastro"></div>
                <div class="form-group"><label>Endereço</label><input type="text" id="enderecoClienteCadastro"></div>
                <div class="form-group"><label>Complemento</label><input type="text" id="complementoClienteCadastro"></div>
                <div class="form-group"><label>Cidade</label><input type="text" id="cidadeClienteCadastro"></div>
                <div class="form-group"><label>Estado</label><input type="text" id="estadoClienteCadastro"></div>
                <div class="form-group"><label>CEP</label><input type="text" id="cepClienteCadastro"></div>
                <div class="form-group" style="grid-column:1/-1;"><label>Observação</label><textarea id="obsClienteCadastro" style="min-height:80px;"></textarea></div>
            </div>
            <button class="btn" onclick="adicionarClienteSimples()">✅ Cadastrar Cliente</button>
        </div>

        <!-- MEUS CLIENTES -->
        <div id="listaClientes" class="box">
            <h2>👥 Meus Clientes <button class="btn refresh-btn" onclick="carregarClientesSimples()">🔄</button></h2>
            <div class="stats-grid">
                <div class="stat-card"><div class="stat-label">Total</div><div class="stat-value" id="totalClientesLista">0</div></div>
                <div class="stat-card" style="border-left-color:#22c55e;"><div class="stat-label">Ativos</div><div class="stat-value" id="clientesAtivosLista">0</div></div>
                <div class="stat-card" style="border-left-color:#f59e0b;"><div class="stat-label">Inativos</div><div class="stat-value" id="clientesInativosLista">0</div></div>
            </div>
            <h3>✅ Clientes Ativos</h3>
            <input type="text" id="buscaClienteSimples" class="search-input" placeholder="🔍 Buscar..." onkeyup="filtrarClientesSimples()">
            <div class="table-responsive"><table id="tabClientesSimples"><thead><tr><th>Nome</th><th>Telefone</th><th>Email</th><th>Endereço</th><th>Cidade</th><th>Última Venda</th><th>Ações</th></tr></thead><tbody></tbody></table></div>
            <div id="containerInativos" style="display:none;"><h3>⚠️ Clientes Inativos</h3><input type="text" id="buscaClientesInativos" class="search-input" placeholder="🔍 Buscar..." onkeyup="filtrarClientesInativos()"><div class="table-responsive"><table id="tabClientesInativos"><thead><tr><th>Nome</th><th>Telefone</th><th>Email</th><th>Endereço</th><th>Cidade</th><th>Cadastro</th><th>Ações</th></tr></thead><tbody></tbody></table></div></div>
        </div>

        <!-- VENDAS À VISTA -->
        <div id="vendasAvista" class="box">
            <h2>💰 Vendas à Vista <button class="btn refresh-btn" onclick="carregarVendasAvista()">🔄</button></h2>
            <div class="form-grid">
                <div class="form-group"><label>Cliente *</label><select id="clienteVenda"><option value="">Selecione</option></select></div>
                <div class="form-group"><label>Produto *</label><input type="text" id="tipoProduto"></div>
                <div class="form-group"><label>Quantidade *</label><input type="number" id="qtdVenda" value="1" min="1" step="0.01"></div>
                <div class="form-group"><label>Valor Unitário (R$) *</label><input type="number" id="valorUnitario" step="0.01"></div>
                <div class="form-group"><label>Data Venda</label><input type="date" id="dataVenda"></div>
                <div class="form-group"><label>Observação</label><input type="text" id="obsVenda"></div>
            </div>
            <button class="btn" onclick="registrarVenda()">Registrar Venda à Vista</button>
            <h3>📊 Histórico de Vendas à Vista</h3>
            <input type="text" id="buscaVenda" class="search-input" placeholder="🔍 Buscar..." onkeyup="filtrarVendas()">
            <div class="table-responsive"><table id="tabHistoricoVendas"><thead><tr><th>Data</th><th>Cliente</th><th>Produto</th><th>Qtd</th><th>Unitário</th><th>Total</th><th>Ações</th></tr></thead><tbody></tbody></table></div>
        </div>

        <!-- VENDAS PARCELADAS -->
        <div id="clientesFinanceiros" class="box">
            <h2>📆 Vendas Parceladas <button class="btn refresh-btn" onclick="carregarClientesFinanceiros()">🔄</button></h2>
            <h3>➕ Registrar Venda Parcelada</h3>
            <div class="form-grid">
                <div class="form-group"><label>Cliente *</label><select id="clienteParcelado"><option value="">Escolha...</option></select></div>
                <div class="form-group"><label>Produto *</label><input type="text" id="produtoParcelado"></div>
                <div class="form-group"><label>Data Compra</label><input type="date" id="dataCompraParcelado"></div>
                <div class="form-group"><label>Valor Total (R$) *</label><input type="number" id="valorTotalParcelado" step="0.01" oninput="calcularParcelaParcelado()"></div>
                <div class="form-group"><label>Entrada (R$)</label><input type="number" id="entradaParcelado" step="0.01" value="0" oninput="calcularParcelaParcelado()"></div>
                <div class="form-group"><label>Tipo Parcelamento</label><select id="tipoParcelamentoParcelado" onchange="alternarParcelamentoParcelado()"><option value="auto">Automático</option><option value="manual">Manual (datas)</option></select></div>
                <div id="grupoAutoParcelado"><div class="form-group"><label>Frequência</label><select id="frequenciaParcelado" onchange="calcularParcelaParcelado()"><option value="semanal">Semanal</option><option value="quinzenal">Quinzenal</option><option value="mensal" selected>Mensal</option></select></div><div class="form-group"><label>Nº Parcelas</label><input type="number" id="parcelasParcelado" min="1" value="1" oninput="calcularParcelaParcelado()"></div></div>
                <div id="grupoManualParcelado" style="display:none;"><div class="form-group"><label>Datas (dd/mm/aaaa)</label><textarea id="datasParcelasParcelado" placeholder="10/05/2026\n10/06/2026" oninput="calcularParcelaParcelado()"></textarea></div></div>
                <div class="form-group"><label>Valor Parcela</label><input type="text" id="valorParcelaParcelado" readonly></div>
            </div>
            <button class="btn" onclick="adicionarVendaParcelada()">Salvar Venda Parcelada</button>
            <h3 style="margin-top:40px;">📋 Lista de Parcelamentos</h3>
            <input type="text" id="buscaParcelado" class="search-input" placeholder="🔍 Buscar..." onkeyup="filtrarParcelado()">
            <div class="table-responsive"><table id="tabParcelado"><thead><tr><th>Cliente</th><th>Produto</th><th>Total</th><th>Pago</th><th>Restante</th><th>Status</th><th>Próx. Venc.</th><th>Ações</th></tr></thead><tbody></tbody></table></div>
        </div>

        <!-- PAGAMENTOS -->
        <div id="pagamentos" class="box">
            <h2>💵 Pagamentos <button class="btn refresh-btn" onclick="carregarPagamentos()">🔄</button></h2>
            <div style="margin-bottom:20px; padding:15px; background:#1e293b; border-radius:10px;"><label>📅 Filtrar por Período</label><div style="display:flex; gap:10px; flex-wrap:wrap;"><input type="date" id="filtroDataInicio"><input type="date" id="filtroDataFim"><button class="btn btn-sm" onclick="aplicarFiltroPagamentos()">Filtrar</button><button class="btn btn-sm" onclick="limparFiltroPagamentos()">Limpar</button></div></div>
            <div id="alertaVencimento" class="alert-card" style="display:none;"><h4>⚠️ Parcelas Vencendo</h4><div id="listaAlertas"></div></div>
            <input type="text" id="buscaPagamento" class="search-input" placeholder="🔍 Buscar..." onkeyup="filtrarPagamentos()">
            <div class="table-responsive"><table id="tabPagamentos"><thead><tr><th>Cliente</th><th>Total</th><th>Pago</th><th>Restante</th><th>Parcelas (venc.)</th><th>Valor Pagar</th><th>Ações</th></tr></thead><tbody></tbody></table></div>
        </div>

        <!-- ESTOQUE -->
        <div id="estoque" class="box">
            <h2>📦 Estoque <button class="btn refresh-btn" onclick="carregarEstoque()">🔄</button></h2>
            <h3>➕ Adicionar Produto</h3>
            <div class="form-grid">
                <div class="form-group"><label>Produto *</label><input type="text" id="estoqueProduto"></div>
                <div class="form-group"><label>Quantidade *</label><input type="number" id="estoqueQtd" value="1" min="0" step="0.01"></div>
                <div class="form-group"><label>Custo Unitário (R$) *</label><input type="number" id="custoUnit" step="0.01"></div>
                <div class="form-group"><label>Preço Venda (R$) *</label><input type="number" id="precoVenda" step="0.01"></div>
                <div class="form-group"><label>SKU</label><input type="text" id="skuProduto"></div>
                <div class="form-group"><label>Categoria</label><input type="text" id="categoriaProduto"></div>
            </div>
            <button class="btn" onclick="adicionarEstoque()">Adicionar</button>
            <h3>📋 Produtos em Estoque</h3>
            <input type="text" id="buscaEstoque" class="search-input" placeholder="🔍 Buscar..." onkeyup="filtrarEstoque()">
            <div class="table-responsive"><table id="tabEstoque"><thead><tr><th>Produto</th><th>Qtd</th><th>Custo</th><th>Preço</th><th>Lucro Unit.</th><th>Valor Total</th><th>Ações</th></tr></thead><tbody></tbody></table></div>
        </div>

        <!-- FORNECEDORES -->
