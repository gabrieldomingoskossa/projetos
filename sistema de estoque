<script>
// FIREBASE
const firebaseConfig = {
    apiKey: "AIzaSyAsVEFjNROfnaSAp6sJfqnNN-FQR6Ooa4Q",
    authDomain: "jg-store.firebaseapp.com",
    projectId: "jg-store",
    storageBucket: "jg-store.firebasestorage.app",
    messagingSenderId: "974018653999",
    appId: "1:974018653999:web:4aae3700c4a8ab5946fbda"
};
firebase.initializeApp(firebaseConfig);
const db = firebase.firestore();

// VARIÁVEIS GLOBAIS
let clientesSimples = [];
let clientesFinanceiros = [];
let vendasAvista = [];
let estoque = [];
let fornecedores = [];
let clienteEmEdicao = null;
let graficoVendas = null;
let graficoRelatorio = null;
let filtroDataInicio = '';
let filtroDataFim = '';

// ==================== UTILITÁRIOS ====================
function mostrarToast(msg, tipo = 'info') {
    const toast = document.createElement('div');
    toast.className = `toast ${tipo}`;
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => toast.remove(), 3000);
}
function formatarMoeda(v) { return v.toLocaleString('pt-BR', { minimumFractionDigits: 2 }); }
function adicionarMeses(d, m) { let nd = new Date(d); nd.setMonth(nd.getMonth() + m); return nd; }
function adicionarDias(d, dias) { let nd = new Date(d); nd.setDate(nd.getDate() + dias); return nd; }
function dataParaBR(d) { if (typeof d === 'string' && d.includes('/')) return d; let dd = new Date(d); return `${String(dd.getDate()).padStart(2, '0')}/${String(dd.getMonth() + 1).padStart(2, '0')}/${dd.getFullYear()}`; }
function parseData(str) { if (!str) return null; let [dia, mes, ano] = str.split('/'); return new Date(ano, mes - 1, dia); }
function limparCampos(...ids) { ids.forEach(id => { let el = document.getElementById(id); if (el) el.value = ''; }); }

// ==================== LOGIN ====================
function fazerLogin() {
    const user = document.getElementById('loginUser').value.trim();
    const pass = document.getElementById('loginPass').value.trim();
    const err = document.getElementById('loginError');
    if (!user || !pass) { err.textContent = 'Preencha usuário e senha'; return; }
    if (user === 'jgstore' && pass === 'jgstore') {
        sessionStorage.setItem('auth', 'true');
        document.getElementById('loginContainer').style.display = 'none';
        document.getElementById('mainSystem').style.display = 'block';
        carregarTudo();
        mostrarToast('✅ Bem-vindo!', 'success');
    } else { err.textContent = '❌ Usuário ou senha inválidos!'; }
}
function fazerLogout() {
    if (confirm('Deseja sair?')) {
        sessionStorage.removeItem('auth');
        document.getElementById('mainSystem').style.display = 'none';
        document.getElementById('loginContainer').style.display = 'flex';
        mostrarToast('Saiu do sistema', 'info');
    }
}
if (sessionStorage.getItem('auth') === 'true') {
    document.getElementById('loginContainer').style.display = 'none';
    document.getElementById('mainSystem').style.display = 'block';
    carregarTudo();
}

// ==================== NAVEGAÇÃO DASHBOARD ====================
function navegarPara(secao) {
    const botoes = document.querySelectorAll('.menu button');
    let botaoAlvo = null;
    const mapa = {
        'listaClientes': '👥 Meus Clientes',
        'vendasAvista': '💰 Vendas à Vista',
        'clientesFinanceiros': '📆 Vendas Parceladas',
        'fornecedores': '🚚 Fornecedores',
        'relatorios': '📈 Relatórios'
    };
    for (let btn of botoes) {
        if (btn.textContent.includes(mapa[secao])) {
            botaoAlvo = btn;
            break;
        }
    }
    if (botaoAlvo) irPara(botaoAlvo, secao);
    else irPara(null, secao);
}

function irPara(btn, secao) {
    document.querySelectorAll('.box').forEach(b => b.classList.remove('active'));
    document.getElementById(secao).classList.add('active');
    if (btn) {
        document.querySelectorAll('.menu button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
    }
    if (secao === 'dashboard') carregarDashboard();
    if (secao === 'pagamentos') renderizarPagamentos();
    if (secao === 'relatorios') carregarRelatorios();
}

// ==================== CARREGAMENTOS GERAIS ====================
async function carregarTudo() {
    try {
        await Promise.all([
            carregarClientesSimples(),
            carregarClientesFinanceiros(),
            carregarVendasAvista(),
            carregarEstoque(),
            carregarFornecedores()
        ]);
        carregarDashboard();
    } catch (e) { mostrarToast('Erro ao carregar: ' + e.message, 'error'); }
}

async function carregarClientesSimples() {
    const snap = await db.collection("clientes_simples").orderBy("nome").get();
    clientesSimples = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderizarClientesSimples();
    atualizarSelectClientesVendas();
    atualizarSelectClientesParcelado();
}
async function carregarClientesFinanceiros() {
    const snap = await db.collection("clientes_financeiros").orderBy("clienteNome").get();
    clientesFinanceiros = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderizarParcelado();
    if (document.getElementById('pagamentos').classList.contains('active')) renderizarPagamentos();
}
async function carregarVendasAvista() {
    const snap = await db.collection("vendas").orderBy("data", "desc").get();
    vendasAvista = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderizarVendas();
    carregarDashboard(); 
}
async function carregarEstoque() {
    const snap = await db.collection("estoque").get();
    estoque = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderizarEstoque();
}
async function carregarFornecedores() {
    const snap = await db.collection("fornecedores").get();
    fornecedores = snap.docs.map(d => ({ id: d.id, ...d.data() }));
    renderizarFornecedores();
}

// ==================== DASHBOARD ====================
async function carregarDashboard() {
    document.getElementById('statClientes').textContent = clientesSimples.length;
    document.getElementById('statVendasAvista').textContent = vendasAvista.length;
    document.getElementById('statVendasParceladas').textContent = clientesFinanceiros.length;
    const receitaAvista = vendasAvista.reduce((a, v) => a + (v.valorTotal || 0), 0);
    const receitaParceladas = clientesFinanceiros.reduce((a, c) => a + (c.total || 0), 0);
    const receitaTotal = receitaAvista + receitaParceladas;
    document.getElementById('statReceita').innerHTML = formatarMoeda(receitaTotal);
    const gastoForn = fornecedores.reduce((a, f) => a + (f.valor || 0), 0);
    document.getElementById('statGastoFornecedores').innerHTML = formatarMoeda(gastoForn);
    const lucroTotal = receitaTotal - gastoForn;
    document.getElementById('statLucroTotal').innerHTML = formatarMoeda(lucroTotal);
    const inadimplentes = clientesFinanceiros.filter(c => (c.total || 0) - (c.pago || 0) > 0);
    document.getElementById('statInadimplentes').textContent = inadimplentes.length;
    const aReceber = clientesFinanceiros.reduce((a, c) => a + ((c.total || 0) - (c.pago || 0)), 0);
    document.getElementById('statAReceber').innerHTML = formatarMoeda(aReceber);
    document.getElementById('resReceita').innerHTML = formatarMoeda(receitaTotal);
    document.getElementById('resCusto').innerHTML = formatarMoeda(gastoForn);
    document.getElementById('resLucro').innerHTML = formatarMoeda(lucroTotal);
    document.getElementById('resPercentualCusto').textContent = receitaTotal > 0 ? Math.round((gastoForn / receitaTotal) * 100) : 0;
    document.getElementById('resPercentualLucro').textContent = receitaTotal > 0 ? Math.round((lucroTotal / receitaTotal) * 100) : 0;
    atualizarGraficoVendas();
    atualizarTopProdutos();
    atualizarTopFornecedores();
    atualizarInadimplentes();
}

function atualizarGraficoVendas() {
    const ctx = document.getElementById('graficoVendas');
    if (!ctx) return;
    const porMes = {};
    vendasAvista.forEach(v => { if (!v.data) return; const d = new Date(v.data); const mes = `${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`; porMes[mes] = (porMes[mes] || 0) + (v.valorTotal || 0); });
    clientesFinanceiros.forEach(c => { if (!c.data) return; const d = new Date(c.data); const mes = `${String(d.getMonth() + 1).padStart(2, '0')}/${d.getFullYear()}`; porMes[mes] = (porMes[mes] || 0) + (c.total || 0); });
    const labels = Object.keys(porMes).sort();
    const dados = labels.map(l => porMes[l]);
    if (graficoVendas) graficoVendas.destroy();
    graficoVendas = new Chart(ctx, { type: 'bar', data: { labels, datasets: [{ label: 'Vendas (R$)', data: dados, backgroundColor: '#3b82f6' }] }, options: { responsive: true, scales: { y: { beginAtZero: true, ticks: { callback: val => 'R$ ' + formatarMoeda(val) } } } } });
}

function atualizarTopProdutos() {
    const qtd = {}, fat = {};
    vendasAvista.forEach(v => { qtd[v.produto] = (qtd[v.produto] || 0) + (v.quantidade || 0); fat[v.produto] = (fat[v.produto] || 0) + (v.valorTotal || 0); });
    clientesFinanceiros.forEach(c => { qtd[c.produto] = (qtd[c.produto] || 0) + 1; fat[c.produto] = (fat[c.produto] || 0) + (c.total || 0); });
    const top = Object.entries(qtd).sort((a, b) => b[1] - a[1]).slice(0, 5);
    const tbody = document.querySelector('#tabTopProdutos tbody');
    if (tbody) { tbody.innerHTML = ''; if (top.length === 0) tbody.innerHTML = '<tr><td colspan="3">Nenhuma venda</td></tr>'; else top.forEach(([p, q]) => { let tr = document.createElement('tr'); tr.innerHTML = `<td>${p}</td><td>${q}</td><td>R$ ${formatarMoeda(fat[p])}</td>`; tbody.appendChild(tr); }); }
}

function atualizarTopFornecedores() {
    const gasto = {}, prods = {};
    fornecedores.forEach(f => { gasto[f.nome] = (gasto[f.nome] || 0) + (f.valor || 0); if (!prods[f.nome]) prods[f.nome] = []; prods[f.nome].push(f.produto); });
    const top = Object.entries(gasto).sort((a, b) => b[1] - a[1]).slice(0, 5);
    const tbody = document.querySelector('#tabTopFornecedores tbody');
    if (tbody) { tbody.innerHTML = ''; if (top.length === 0) tbody.innerHTML = '<tr><td colspan="3">Nenhum fornecedor</td></tr>'; else top.forEach(([nome, val]) => { let tr = document.createElement('tr'); tr.innerHTML = `<td>${nome}</td><td>${prods[nome].join(', ')}</td><td>R$ ${formatarMoeda(val)}</td>`; tbody.appendChild(tr); }); }
}

function atualizarInadimplentes() {
    const inad = clientesFinanceiros.filter(c => (c.total || 0) - (c.pago || 0) > 0);
    const tbody = document.querySelector('#tabInadimplentes tbody');
    if (tbody) { tbody.innerHTML = ''; if (inad.length === 0) tbody.innerHTML = '<tr><td colspan="5">✅ Todos pagos!</td></tr>'; else inad.forEach(c => { const debito = (c.total || 0) - (c.pago || 0); const pct = c.total > 0 ? Math.round(((c.pago || 0) / c.total) * 100) : 0; const prox = obterProxVencimento(c) || '—'; let tr = document.createElement('tr'); tr.innerHTML = `<td>${c.clienteNome}</td><td style="color:#ef4444"><strong>R$ ${formatarMoeda(debito)}</strong></td><td>${pct}%</td><td>${prox}</td><td><button class="btn btn-sm" onclick="mostrarParcelasModal('${c.id}','fin')">Ver</button></td>`; tbody.appendChild(tr); }); }
}

// ==================== CLIENTES SIMPLES ====================
async function adicionarClienteSimples() {
    const nome = document.getElementById('nomeClienteCadastro').value.trim();
    if (!nome) return mostrarToast('Nome obrigatório', 'error');
    const btn = event.target;
    btn.disabled = true; btn.textContent = 'Salvando...';
    try {
        await db.collection("clientes_simples").add({
            nome, telefone: document.getElementById('telefoneClienteCadastro').value,
            email: document.getElementById('emailClienteCadastro').value,
            cpf: document.getElementById('cpfClienteCadastro').value,
            endereco: document.getElementById('enderecoClienteCadastro').value,
            complemento: document.getElementById('complementoClienteCadastro').value,
            cidade: document.getElementById('cidadeClienteCadastro').value,
            estado: document.getElementById('estadoClienteCadastro').value,
            cep: document.getElementById('cepClienteCadastro').value,
            obs: document.getElementById('obsClienteCadastro').value,
            dataCriacao: new Date().toISOString()
        });
        limparCampos('nomeClienteCadastro', 'telefoneClienteCadastro', 'emailClienteCadastro', 'cpfClienteCadastro', 'enderecoClienteCadastro', 'complementoClienteCadastro', 'cidadeClienteCadastro', 'estadoClienteCadastro', 'cepClienteCadastro', 'obsClienteCadastro');
        await carregarClientesSimples();
        mostrarToast('✅ Cliente cadastrado', 'success');
    } catch (e) { mostrarToast('Erro: ' + e.message, 'error'); }
    finally { btn.disabled = false; btn.textContent = '✅ Cadastrar Cliente'; }
}

function renderizarClientesSimples() {
    const termo = document.getElementById('buscaClienteSimples')?.value.toLowerCase() || '';
    const comVendas = new Set([...vendasAvista.map(v => v.clienteId), ...clientesFinanceiros.map(c => c.clienteId)]);
    const ativos = clientesSimples.filter(c => comVendas.has(c.id));
    const inativos = clientesSimples.filter(c => !comVendas.has(c.id));
    const filtrados = termo ? ativos.filter(c => c.nome.toLowerCase().includes(termo) || (c.telefone && c.telefone.toLowerCase().includes(termo))) : ativos;
    document.getElementById('totalClientesLista').textContent = clientesSimples.length;
    document.getElementById('clientesAtivosLista').textContent = ativos.length;
    document.getElementById('clientesInativosLista').textContent = inativos.length;
    const tbody = document.querySelector('#tabClientesSimples tbody');
    if (tbody) {
        tbody.innerHTML = '';
        if (filtrados.length === 0) tbody.innerHTML = '<tr><td colspan="7">Nenhum cliente ativo</td></tr>';
        else filtrados.forEach(c => {
            const ultimaVendaAvista = vendasAvista.filter(v => v.clienteId === c.id)[0]?.data;
            const ultimaParcelada = clientesFinanceiros.filter(cf => cf.clienteId === c.id)[0]?.data;
            const ultima = ultimaVendaAvista || ultimaParcelada || '—';
            let tr = document.createElement('tr');
            tr.innerHTML = `<td>${c.nome}</td><td>${c.telefone || '—'}</td><td>${c.email || '—'}</td><td>${c.endereco || '—'}</td><td>${c.cidade || '—'}</td><td>${ultima}</td><td><button class="btn btn-danger btn-sm" onclick="excluirClienteSimples('${c.id}')">Excluir</button></td>`;
            tbody.appendChild(tr);
        });
    }
    const container = document.getElementById('containerInativos');
    if (inativos.length > 0) {
        container.style.display = 'block';
        const termoIna = document.getElementById('buscaClientesInativos')?.value.toLowerCase() || '';
        const inativosF = termoIna ? inativos.filter(c => c.nome.toLowerCase().includes(termoIna)) : inativos;
        const tbodyIna = document.querySelector('#tabClientesInativos tbody');
        if (tbodyIna) {
            tbodyIna.innerHTML = '';
            inativosF.forEach(c => {
                let tr = document.createElement('tr');
                tr.innerHTML = `<td>${c.nome}</td><td>${c.telefone || '—'}</td><td>${c.email || '—'}</td><td>${c.endereco || '—'}</td><td>${c.cidade || '—'}</td><td>${c.dataCriacao ? new Date(c.dataCriacao).toLocaleDateString('pt-BR') : '—'}</td><td><button class="btn btn-danger btn-sm" onclick="excluirClienteSimples('${c.id}')">Excluir</button></td>`;
                tbodyIna.appendChild(tr);
            });
        }
    } else container.style.display = 'none';
}
function filtrarClientesSimples() { renderizarClientesSimples(); }
function filtrarClientesInativos() { renderizarClientesSimples(); }
async function excluirClienteSimples(id) { if (confirm('Excluir cliente?')) { await db.collection("clientes_simples").doc(id).delete(); await carregarClientesSimples(); mostrarToast('Cliente excluído', 'success'); } }
function atualizarSelectClientesVendas() { let select = document.getElementById('clienteVenda'); if (select) { select.innerHTML = '<option value="">Selecione</option>'; clientesSimples.forEach(c => { let opt = document.createElement('option'); opt.value = c.id; opt.textContent = c.nome; select.appendChild(opt); }); } }
function atualizarSelectClientesParcelado() { let select = document.getElementById('clienteParcelado'); if (select) { select.innerHTML = '<option value="">Escolha...</option>'; clientesSimples.forEach(c => { let opt = document.createElement('option'); opt.value = c.id; opt.textContent = c.nome; select.appendChild(opt); }); } }

// ==================== VENDAS À VISTA ====================
async function registrarVenda() {
    const clienteId = document.getElementById('clienteVenda').value;
    const produto = document.getElementById('tipoProduto').value.trim();
    const qtd = parseFloat(document.getElementById('qtdVenda').value) || 0;
    const unit = parseFloat(document.getElementById('valorUnitario').value) || 0;
    const data = document.getElementById('dataVenda').value;
    if (!clienteId || !produto || qtd <= 0 || unit <= 0 || !data) return mostrarToast('Preencha todos os campos', 'error');
    const cliente = clientesSimples.find(c => c.id === clienteId);
    if (!cliente) return mostrarToast('Cliente não encontrado', 'error');
    const btn = event.target;
    btn.disabled = true; btn.textContent = 'Registrando...';
    try {
        await db.collection("vendas").add({ clienteId, clienteNome: cliente.nome, produto, quantidade: qtd, valorUnit: unit, valorTotal: qtd * unit, data, observacao: document.getElementById('obsVenda').value, dataCriacao: new Date().toISOString() });
        limparCampos('tipoProduto', 'qtdVenda', 'valorUnitario', 'obsVenda');
        document.getElementById('clienteVenda').value = '';
        document.getElementById('dataVenda').value = new Date().toISOString().split('T')[0];
        await carregarVendasAvista();
        await carregarClientesSimples();
        carregarDashboard();
        mostrarToast('✅ Venda à vista registrada', 'success');
    } catch (e) { mostrarToast('Erro: ' + e.message, 'error'); }
    finally { btn.disabled = false; btn.textContent = 'Registrar Venda à Vista'; }
}
function renderizarVendas() {
    const termo = document.getElementById('buscaVenda')?.value.toLowerCase() || '';
    const filtradas = termo ? vendasAvista.filter(v => v.clienteNome.toLowerCase().includes(termo) || v.produto.toLowerCase().includes(termo)) : vendasAvista;
    const tbody = document.querySelector('#tabHistoricoVendas tbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    filtradas.forEach(v => {
        let tr = document.createElement('tr');
        tr.innerHTML = `<td>${v.data}</td><td>${v.clienteNome}</td><td>${v.produto}</td><td>${v.quantidade}</td><td>R$ ${formatarMoeda(v.valorUnit)}</td><td>R$ ${formatarMoeda(v.valorTotal)}</td><td><button class="btn btn-danger btn-sm" onclick="excluirVenda('${v.id}')">Excluir</button></td>`;
        tbody.appendChild(tr);
    });
}
function filtrarVendas() { renderizarVendas(); }
async function excluirVenda(id) { if (confirm('Excluir venda?')) { await db.collection("vendas").doc(id).delete(); await carregarVendasAvista(); mostrarToast('Venda excluída', 'success'); } }

// ==================== VENDAS PARCELADAS ====================
function calcularParcelaParcelado() {
    const total = parseFloat(document.getElementById('valorTotalParcelado').value) || 0;
    const entrada = parseFloat(document.getElementById('entradaParcelado').value) || 0;
    const tipo = document.getElementById('tipoParcelamentoParcelado').value;
    let num = 0;
    if (tipo === 'auto') num = parseInt(document.getElementById('parcelasParcelado').value) || 1;
    else num = document.getElementById('datasParcelasParcelado').value.split('\n').filter(l => l.trim()).length;
    const parcela = num > 0 ? (total - entrada) / num : 0;
    document.getElementById('valorParcelaParcelado').value = formatarMoeda(parcela);
}
function alternarParcelamentoParcelado() {
    const tipo = document.getElementById('tipoParcelamentoParcelado').value;
    document.getElementById('grupoAutoParcelado').style.display = tipo === 'auto' ? 'block' : 'none';
    document.getElementById('grupoManualParcelado').style.display = tipo === 'manual' ? 'block' : 'none';
    calcularParcelaParcelado();
}
async function adicionarVendaParcelada() {
    const clienteId = document.getElementById('clienteParcelado').value;
    const produto = document.getElementById('produtoParcelado').value.trim();
    const total = parseFloat(document.getElementById('valorTotalParcelado').value) || 0;
    const entrada = parseFloat(document.getElementById('entradaParcelado').value) || 0;
    if (!clienteId || !produto || total <= 0) return mostrarToast('Preencha cliente, produto e valor total', 'error');
    if (entrada > total) return mostrarToast('Entrada não pode ser maior que total', 'error');
    const btn = event.target;
    btn.disabled = true; btn.textContent = 'Salvando...';
    try {
        const cliente = clientesSimples.find(c => c.id === clienteId);
        const tipo = document.getElementById('tipoParcelamentoParcelado').value;
        const dataCompra = document.getElementById('dataCompraParcelado').value || new Date().toISOString().split('T')[0];
        let numParcelas = 0, personalizadas = [];
        if (tipo === 'auto') numParcelas = parseInt(document.getElementById('parcelasParcelado').value) || 1;
        else {
            personalizadas = document.getElementById('datasParcelasParcelado').value.split('\n').map(l => l.trim()).filter(l => l);
            numParcelas = personalizadas.length;
            if (numParcelas === 0) throw new Error('Informe pelo menos uma data');
        }
        const valorParcela = (total - entrada) / numParcelas;
        const dados = { clienteId, clienteNome: cliente.nome, produto, total, pago: entrada, valorParcela, data: dataCompra, tipoParcelamento: tipo, dataCriacao: new Date().toISOString() };
        if (tipo === 'auto') { dados.frequencia = document.getElementById('frequenciaParcelado').value; dados.parcelas = numParcelas; }
        else dados.parcelasPersonalizadas = personalizadas;
        await db.collection("clientes_financeiros").add(dados);
        limparCampos('produtoParcelado', 'valorTotalParcelado', 'entradaParcelado', 'datasParcelasParcelado');
        document.getElementById('clienteParcelado').value = '';
        document.getElementById('dataCompraParcelado').value = '';
        await carregarClientesFinanceiros();
        await carregarClientesSimples();
        carregarDashboard();
        mostrarToast('✅ Venda parcelada registrada', 'success');
    } catch (e) { mostrarToast('Erro: ' + e.message, 'error'); }
    finally { btn.disabled = false; btn.textContent = 'Salvar Venda Parcelada'; }
}
function obterParcelasCliente(c) {
    if (!c.valorParcela || c.valorParcela <= 0) return [];
    const parcelas = [];
    if (c.tipoParcelamento === 'manual' && c.parcelasPersonalizadas) {
        c.parcelasPersonalizadas.forEach((dataStr, i) => {
            const pago = c.pago >= (i + 1) * c.valorParcela;
            parcelas.push({ numero: i + 1, data: dataStr, valor: c.valorParcela, pago });
        });
    } else {
        const freq = c.frequencia || 'mensal';
        const num = c.parcelas || 1;
        const base = new Date(c.data);
        for (let i = 0; i < num; i++) {
            let dt = new Date(base);
            if (freq === 'semanal') dt = adicionarDias(dt, i * 7);
            else if (freq === 'quinzenal') dt = adicionarDias(dt, i * 15);
            else dt = adicionarMeses(dt, i);
            const pago = c.pago >= (i + 1) * c.valorParcela;
            parcelas.push({ numero: i + 1, data: dataParaBR(dt), valor: c.valorParcela, pago });
        }
    }
    return parcelas;
}
function obterProxVencimento(c) {
    const parcelas = obterParcelasCliente(c);
    const pendente = parcelas.find(p => !p.pago);
    return pendente ? pendente.data : null;
}
function renderizarParcelado() {
    const termo = document.getElementById('buscaParcelado')?.value.toLowerCase() || '';
    const filtrados = termo ? clientesFinanceiros.filter(c => c.clienteNome?.toLowerCase().includes(termo)) : clientesFinanceiros;
    const tbody = document.querySelector('#tabParcelado tbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    filtrados.forEach(c => {
        const restante = (c.total || 0) - (c.pago || 0);
        const status = restante <= 0 ? 'pago' : 'pendente';
        const prox = obterProxVencimento(c) || 'Quitado';
        let tr = document.createElement('tr');
        tr.innerHTML = `<td>${c.clienteNome}</td><td>${c.produto}</td><td>R$ ${formatarMoeda(c.total || 0)}</td><td>R$ ${formatarMoeda(c.pago || 0)}</td><td>R$ ${formatarMoeda(restante)}</td><td><span class="status ${status}">${status.toUpperCase()}</span></td><td>${prox}</td><td><button class="btn btn-sm" onclick="mostrarParcelasModal('${c.id}','fin')">Ver</button> <button class="btn btn-danger btn-sm" onclick="excluirParcelado('${c.id}')">Excluir</button></td>`;
        tbody.appendChild(tr);
    });
}
function filtrarParcelado() { renderizarParcelado(); }
async function excluirParcelado(id) { if (confirm('Excluir venda parcelada?')) { await db.collection("clientes_financeiros").doc(id).delete(); await carregarClientesFinanceiros(); carregarDashboard(); mostrarToast('Excluído', 'success'); } }

// ==================== PAGAMENTOS ====================
async function carregarPagamentos() { renderizarPagamentos(); }
function aplicarFiltroPagamentos() { filtroDataInicio = document.getElementById('filtroDataInicio').value; filtroDataFim = document.getElementById('filtroDataFim').value; renderizarPagamentos(); }
function limparFiltroPagamentos() { document.getElementById('filtroDataInicio').value = ''; document.getElementById('filtroDataFim').value = ''; filtroDataInicio = ''; filtroDataFim = ''; renderizarPagamentos(); }
function renderizarPagamentos() {
    const termo = document.getElementById('buscaPagamento')?.value.toLowerCase() || '';
    let filtrados = termo ? clientesFinanceiros.filter(c => c.clienteNome.toLowerCase().includes(termo)) : clientesFinanceiros;
    filtrados = filtrados.filter(c => ((c.total || 0) - (c.pago || 0)) > 0);
    const tbody = document.querySelector('#tabPagamentos tbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    const alertas = [];
    filtrados.forEach(c => {
        let parcelas = obterParcelasCliente(c).filter(p => !p.pago);
        if (parcelas.length === 0) return;
        if (filtroDataInicio && filtroDataFim) {
            const inicio = new Date(filtroDataInicio);
            const fim = new Date(filtroDataFim);
            parcelas = parcelas.filter(p => { let dp = parseData(p.data); return dp && dp >= inicio && dp <= fim; });
        }
        if (parcelas.length === 0) return;
        const restante = (c.total || 0) - (c.pago || 0);
        const listaDatas = parcelas.map(p => p.data).join(', ');
        let tr = document.createElement('tr');
        tr.innerHTML = `<td>${c.clienteNome}</td><td>R$ ${formatarMoeda(c.total || 0)}</td><td>R$ ${formatarMoeda(c.pago || 0)}</td><td>R$ ${formatarMoeda(restante)}</td><td>${listaDatas}</td><td><input type="number" id="pagar-${c.id}" step="0.01" placeholder="0,00"></td><td><button class="btn btn-success btn-sm" onclick="registrarPagamento('${c.id}')">Pagar</button> <button class="btn btn-warning btn-sm" onclick="mostrarParcelasModal('${c.id}','fin')">Ver</button></td>`;
        tbody.appendChild(tr);
        parcelas.forEach(p => alertas.push({ nome: c.clienteNome, vencimento: p.data, valor: p.valor }));
    });
    const alertDiv = document.getElementById('alertaVencimento');
    if (alertas.length) {
        alertDiv.style.display = 'block';
        document.getElementById('listaAlertas').innerHTML = alertas.map(a => `<div class="alert-item">🔔 ${a.nome} - ${a.vencimento} - R$ ${formatarMoeda(a.valor)}</div>`).join('');
    } else alertDiv.style.display = 'none';
}
function filtrarPagamentos() { renderizarPagamentos(); }
function registrarPagamento(clienteId) {
    const input = document.getElementById(`pagar-${clienteId}`);
    const valor = parseFloat(input.value) || 0;
    if (valor <= 0) return mostrarToast('Digite um valor', 'error');
    clienteEmEdicao = { clienteId, valor };
    document.getElementById('editValorPagamento').value = valor;
    document.getElementById('editDataPagamento').value = new Date().toISOString().split('T')[0];
    document.getElementById('modalEditar').classList.add('active');
}
async function salvarPagamentoEditado() {
    if (!clienteEmEdicao) return;
    const valor = parseFloat(document.getElementById('editValorPagamento').value) || 0;
    if (valor <= 0) return mostrarToast('Valor inválido', 'error');
    try {
        const cliente = clientesFinanceiros.find(c => c.id === clienteEmEdicao.clienteId);
        const novoPago = (cliente.pago || 0) + valor;
        await db.collection("clientes_financeiros").doc(clienteEmEdicao.clienteId).update({ pago: novoPago });
        fecharModalEditar();
        clienteEmEdicao = null;
        await carregarClientesFinanceiros();
        renderizarPagamentos();
        carregarDashboard();
        mostrarToast(`✅ Pagamento de R$ ${formatarMoeda(valor)} registrado`, 'success');
    } catch (e) { mostrarToast('Erro: ' + e.message, 'error'); }
}

// ==================== ESTOQUE ====================
async function adicionarEstoque() {
    const produto = document.getElementById('estoqueProduto').value.trim();
    const qtd = parseFloat(document.getElementById('estoqueQtd').value) || 0;
    const custo = parseFloat(document.getElementById('custoUnit').value) || 0;
    const venda = parseFloat(document.getElementById('precoVenda').value) || 0;
    if (!produto || qtd < 0 || custo <= 0 || venda <= 0) return mostrarToast('Preencha todos os campos obrigatórios', 'error');
    if (venda < custo) return mostrarToast('Preço não pode ser menor que custo', 'error');
    const btn = event.target;
    btn.disabled = true; btn.textContent = 'Adicionando...';
    try {
        await db.collection("estoque").add({ produto, quantidade: qtd, custoUnit: custo, precoVenda: venda, lucroUnit: venda - custo, sku: document.getElementById('skuProduto').value, categoria: document.getElementById('categoriaProduto').value, dataCriacao: new Date().toISOString() });
        limparCampos('estoqueProduto', 'estoqueQtd', 'custoUnit', 'precoVenda', 'skuProduto', 'categoriaProduto');
        await carregarEstoque();
        mostrarToast('✅ Produto adicionado', 'success');
    } catch (e) { mostrarToast('Erro: ' + e.message, 'error'); }
    finally { btn.disabled = false; btn.textContent = 'Adicionar'; }
}
function renderizarEstoque() {
    const termo = document.getElementById('buscaEstoque')?.value.toLowerCase() || '';
    const filtrados = termo ? estoque.filter(e => e.produto.toLowerCase().includes(termo)) : estoque;
    const tbody = document.querySelector('#tabEstoque tbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    filtrados.forEach(item => {
        let tr = document.createElement('tr');
        tr.innerHTML = `<td>${item.produto}</td><td>${item.quantidade || 0}</td><td>R$ ${formatarMoeda(item.custoUnit || 0)}</td><td>R$ ${formatarMoeda(item.precoVenda || 0)}</td><td>R$ ${formatarMoeda(item.lucroUnit || 0)}</td><td>R$ ${formatarMoeda((item.quantidade || 0) * (item.custoUnit || 0))}</td><td><button class="btn btn-danger btn-sm" onclick="excluirEstoque('${item.id}')">Excluir</button></td>`;
        tbody.appendChild(tr);
    });
}
function filtrarEstoque() { renderizarEstoque(); }
async function excluirEstoque(id) { if (confirm('Excluir produto?')) { await db.collection("estoque").doc(id).delete(); await carregarEstoque(); mostrarToast('Produto excluído', 'success'); } }

// ==================== FORNECEDORES ====================
async function adicionarFornecedor() {
    const nome = document.getElementById('fornecedorNome').value.trim();
    const produto = document.getElementById('produtoForn').value.trim();
    const qtd = parseFloat(document.getElementById('qtdForn').value) || 0;
    const valor = parseFloat(document.getElementById('valorForn').value) || 0;
    if (!nome || !produto || qtd <= 0 || valor <= 0) return mostrarToast('Preencha nome, produto, quantidade e valor', 'error');
    const btn = event.target;
    btn.disabled = true; btn.textContent = 'Salvando...';
    try {
        await db.collection("fornecedores").add({ nome, pais: document.getElementById('paisOrigem').value, telefone: document.getElementById('telefoneFornecedor').value, email: document.getElementById('emailFornecedor').value, produto, quantidade: qtd, valor, data: document.getElementById('dataForn').value || new Date().toISOString().split('T')[0], dataCriacao: new Date().toISOString() });
        limparCampos('fornecedorNome', 'paisOrigem', 'telefoneFornecedor', 'emailFornecedor', 'produtoForn', 'qtdForn', 'valorForn', 'dataForn');
        await carregarFornecedores();
        mostrarToast('✅ Fornecedor salvo', 'success');
    } catch (e) { mostrarToast('Erro: ' + e.message, 'error'); }
    finally { btn.disabled = false; btn.textContent = 'Salvar'; }
}
function renderizarFornecedores() {
    const termo = document.getElementById('buscaFornecedor')?.value.toLowerCase() || '';
    const filtrados = termo ? fornecedores.filter(f => f.nome.toLowerCase().includes(termo) || f.produto.toLowerCase().includes(termo)) : fornecedores;
    const tbody = document.querySelector('#tabFornecedores tbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    filtrados.forEach(f => {
        let tr = document.createElement('tr');
        tr.innerHTML = `<td>${f.nome}</td><td>${f.pais || '—'}</td><td>${f.telefone || '—'}</td><td>${f.produto}</td><td>${f.quantidade || 0}</td><td>R$ ${formatarMoeda(f.valor || 0)}</td><td><button class="btn btn-danger btn-sm" onclick="excluirFornecedor('${f.id}')">Excluir</button></td>`;
        tbody.appendChild(tr);
    });
}
function filtrarFornecedores() { renderizarFornecedores(); }
async function excluirFornecedor(id) { if (confirm('Excluir fornecedor?')) { await db.collection("fornecedores").doc(id).delete(); await carregarFornecedores(); mostrarToast('Fornecedor excluído', 'success'); } }

// ==================== RELATÓRIOS ====================
async function carregarRelatorios() { gerarRelatorio(); }
function gerarRelatorio() {
    const inicio = document.getElementById('relDataInicio').value;
    const fim = document.getElementById('relDataFim').value;
    let todasVendas = [];
    vendasAvista.forEach(v => { todasVendas.push({ data: v.data, tipo: 'À vista', descricao: `${v.clienteNome} - ${v.produto} (${v.quantidade}x)`, valor: v.valorTotal }); });
    clientesFinanceiros.forEach(c => { todasVendas.push({ data: c.data, tipo: 'Parcelada', descricao: `${c.clienteNome} - ${c.produto} (${c.parcelas || '?'}x)`, valor: c.total }); });
    if (inicio && fim) {
        const dIni = new Date(inicio);
        const dFim = new Date(fim);
        todasVendas = todasVendas.filter(t => { let d = new Date(t.data); return d >= dIni && d <= dFim; });
    }
    const totalVendas = todasVendas.reduce((a, t) => a + (t.valor || 0), 0);
    const totalCustos = estoque.reduce((a, e) => a + ((e.quantidade || 0) * (e.custoUnit || 0)), 0);
    const lucro = totalVendas - totalCustos;
    document.getElementById('relVendas').innerHTML = formatarMoeda(totalVendas);
    document.getElementById('relCustos').innerHTML = formatarMoeda(totalCustos);
    document.getElementById('relLucro').innerHTML = formatarMoeda(lucro);
    atualizarGraficoRelatorio(todasVendas);
    atualizarTabelaRelatorio(todasVendas);
}
function atualizarGraficoRelatorio(vendasFiltradas) {
    const ctx = document.getElementById('graficoRelatorio');
    if (!ctx) return;
    const porData = {};
    vendasFiltradas.forEach(v => { porData[v.data] = (porData[v.data] || 0) + (v.valor || 0); });
    const labels = Object.keys(porData).sort();
    const dados = labels.map(l => porData[l]);
    if (graficoRelatorio) graficoRelatorio.destroy();
    graficoRelatorio = new Chart(ctx, { type: 'line', data: { labels, datasets: [{ label: 'Vendas (R$)', data: dados, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)', fill: true, tension: 0.4 }] }, options: { responsive: true, scales: { y: { beginAtZero: true, ticks: { callback: val => 'R$ ' + formatarMoeda(val) } } } } });
}
function atualizarTabelaRelatorio(vendasFiltradas) {
    const tbody = document.querySelector('#tabRelatorio tbody');
    if (!tbody) return;
    tbody.innerHTML = '';
    vendasFiltradas.forEach(v => {
        let tr = document.createElement('tr');
        tr.innerHTML = `<td>${v.data}</td><td>${v.tipo}</td><td>${v.descricao}</td><td>R$ ${formatarMoeda(v.valor)}</td>`;
        tbody.appendChild(tr);
    });
}
function exportarCSV() {
    let todasVendas = [];
    vendasAvista.forEach(v => { todasVendas.push({ data: v.data, tipo: 'À vista', descricao: `${v.clienteNome} - ${v.produto} (${v.quantidade}x)`, valor: v.valorTotal }); });
    clientesFinanceiros.forEach(c => { todasVendas.push({ data: c.data, tipo: 'Parcelada', descricao: `${c.clienteNome} - ${c.produto} (${c.parcelas || '?'}x)`, valor: c.total }); });
    let csv = 'Data,Tipo,Descrição,Valor\n';
    todasVendas.forEach(v => { csv += `"${v.data}","${v.tipo}","${v.descricao}","R$ ${formatarMoeda(v.valor)}"\n`; });
    const a = document.createElement('a');
    a.href = 'data:text/csv;charset=utf-8,' + encodeURIComponent(csv);
    a.download = `relatorio_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    mostrarToast('✅ CSV exportado', 'success');
}

// ==================== MODAIS ====================
function mostrarParcelasModal(id, tipo) {
    let cliente = null;
    if (tipo === 'fin') cliente = clientesFinanceiros.find(c => c.id === id);
    if (!cliente) return;
    const parcelas = obterParcelasCliente(cliente);
    let html = '<div class="table-responsive"><table><thead><tr><th>#</th><th>Vencimento</th><th>Valor</th><th>Status</th></tr></thead><tbody>';
    parcelas.forEach(p => { html += `<tr><td>${p.numero}</td><td>${p.data}</td><td>R$ ${formatarMoeda(p.valor)}</td><td>${p.pago ? '✅ Pago' : '⏳ Pendente'}</td></tr>`; });
    html += '</tbody></table></div>';
    document.getElementById('modalTitulo').innerHTML = `Parcelas - ${cliente.clienteNome}`;
    document.getElementById('modalCorpo').innerHTML = html;
    document.getElementById('modalParcelas').classList.add('active');
}
function fecharModal() { document.getElementById('modalParcelas').classList.remove('active'); }
function fecharModalEditar() { document.getElementById('modalEditar').classList.remove('active'); }

// ==================== INIT ====================
document.addEventListener('DOMContentLoaded', () => {
    const hoje = new Date().toISOString().split('T')[0];
    document.querySelectorAll('input[type="date"]').forEach(campo => { if (!campo.value) campo.value = hoje; });
    alternarParcelamentoParcelado();
    calcularParcelaParcelado();
});
</script>
